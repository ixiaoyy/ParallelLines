# This file contains no credentials. Run init.cjs on the server to create .env.
# Only the server owner fills the following two settings locally on that server.
OPENAI_API_KEY=
OPENAI_CHAT_MODELS=

CHAT_PUBLIC_URL=https://pingxingxian.space/chat
PARALLELLINES_NETWORK=parallellines_default
CHAT_ADMIN_PORT=3091

# Generated once by init.cjs. Preserve these values across recreates and rollback.
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_PANEL_SESSION_SECRET=
