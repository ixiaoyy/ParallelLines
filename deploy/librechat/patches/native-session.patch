+const withTransientAuthRetry = async <T>(operation: () => Promise<T>): Promise<T> => {
+  for (let failureCount = 0; ; failureCount++) {
+    try {
+      return await operation();
+    } catch (error) {
+      if (!shouldRetryTransientAuth(failureCount, error)) {
+        throw error;
+      }
+      await new Promise<void>((resolve) => setTimeout(resolve, authTransientRetryDelay(failureCount)));
+    }
+  }
+};
