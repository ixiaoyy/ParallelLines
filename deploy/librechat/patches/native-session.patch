+        'ECONNABORTED',
+        'ETIMEDOUT',
+        'ECONNRESET',
+        'ENOTFOUND',
+        'EAI_AGAIN',
+      ].includes(candidate.code)) ||
+    candidate.name === 'TimeoutError' ||
+    candidate.name === 'NetworkError'
+  );
