+// A temporary transport failure is not evidence that the existing session ended.
+// This classification never authorizes a request or changes its server response.
+const isTransientAuthError = (error: unknown): boolean => {
+  if (typeof error !== 'object' || error === null) {
+    return false;
+  }
+  const candidate = error as {
+    response?: { status?: unknown };
+    status?: unknown;
+    code?: unknown;
+    name?: unknown;
