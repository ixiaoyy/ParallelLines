# syntax=docker/dockerfile:1
FROM node:22-alpine AS build

WORKDIR /repo
RUN corepack enable

# 与主站、圈子共用源码和锁文件，游戏站使用独立构建模式及产物目录。
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN --mount=type=cache,id=parallellines-pnpm-11,target=/pnpm/store \
    pnpm install --filter @parallellines/web... --frozen-lockfile --store-dir=/pnpm/store

COPY apps/web apps/web
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_STATIC_ASSET_BASE_URL=https://img.pingxingxian.space/static/web
ARG VITE_PUBLIC_GAMES_URL=https://games.pingxingxian.space/
ARG VITE_UNIFIED_AUTH_ENABLED=false
ARG VITE_TRAFFIC_ANALYTICS_ENABLED=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_STATIC_ASSET_BASE_URL=$VITE_STATIC_ASSET_BASE_URL
ENV VITE_PUBLIC_GAMES_URL=$VITE_PUBLIC_GAMES_URL
ENV VITE_UNIFIED_AUTH_ENABLED=$VITE_UNIFIED_AUTH_ENABLED
ENV VITE_TRAFFIC_ANALYTICS_ENABLED=$VITE_TRAFFIC_ANALYTICS_ENABLED
RUN pnpm --dir apps/web build:games

FROM nginx:1.27-alpine
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION

# 静态容器不持有证书、账号或数据库；公网入口由独立游戏站 vhost 接管。
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist-games /usr/share/nginx/html
EXPOSE 80
