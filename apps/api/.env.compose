ENVIRONMENT=local
API_V1_PREFIX=/api/v1

DATABASE_URL=mysql+asyncmy://root:root@mysql:3306/parallellines?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://localhost:5174","http://127.0.0.1:5174"]
JWT_SECRET_KEY=change-me-in-production-with-at-least-32-bytes

EMAIL_DELIVERY_MODE=memory
UPLOAD_STORAGE_BACKEND=local
UPLOAD_STORAGE_PATH=/var/lib/parallellines/uploads
BACKUP_STORAGE_PATH=/var/lib/parallellines/backups
