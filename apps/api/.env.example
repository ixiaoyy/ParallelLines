# Local development example. Copy to .env and fill secrets.
# The local private .env is ignored by git.

ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# Docker Compose PostgreSQL default:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parallellines

# MySQL alternative:
# DATABASE_URL=mysql+asyncmy://user:password@host:3306/parallellines

# SQLite for CI/smoke only:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
JWT_SECRET_KEY=change-me-in-production-with-at-least-32-bytes
SLOW_REQUEST_MS=500
BACKGROUND_JOB_POLL_SECONDS=5
BACKGROUND_JOB_BATCH_SIZE=25
BACKGROUND_JOB_RETRY_DELAY_SECONDS=60
BACKGROUND_HOT_RANK_INTERVAL_SECONDS=300
BACKGROUND_UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
BACKGROUND_SESSION_CLEANUP_INTERVAL_SECONDS=3600
BACKGROUND_DIGEST_INTERVAL_SECONDS=3600

# Registration email verification.
# Local/test defaults keep verification emails in memory and expose a dev-only code in API responses.
# Use EMAIL_DELIVERY_MODE=smtp with real SMTP settings in staging/production.
# 163/Netease Mail example:
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_USERNAME=your-name@163.com
#   SMTP_PASSWORD=your-163-smtp-authorization-code
#   SMTP_FROM_EMAIL=your-name@163.com
#   SMTP_USE_TLS=false
#   SMTP_USE_SSL=true
EMAIL_DELIVERY_MODE=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@parallellines.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_CHANGE_TOKEN_TTL_MINUTES=30
TWO_FACTOR_CHALLENGE_MINUTES=5
TWO_FACTOR_ISSUER=ParallelLines
OAUTH_ENABLED_PROVIDERS=[]
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_IP=5
RATE_LIMIT_REGISTER_EMAIL=3
RATE_LIMIT_LOGIN_IP=10
RATE_LIMIT_LOGIN_ACCOUNT=10
RATE_LIMIT_TOPIC_USER=5
RATE_LIMIT_TOPIC_IP=10
RATE_LIMIT_REPLY_USER=10
RATE_LIMIT_REPLY_IP=20
RATE_LIMIT_UPLOAD_USER=20
RATE_LIMIT_UPLOAD_IP=30
RATE_LIMIT_FLAG_USER=10
RATE_LIMIT_FLAG_IP=20
NEW_USER_LINK_LIMIT=5
NEW_USER_SCREENING_DAYS=7

# Uploads and local attachment storage.
# Local backend stores objects under UPLOAD_STORAGE_PATH; keep it on persistent volume in prod.
UPLOAD_STORAGE_BACKEND=local
UPLOAD_STORAGE_PATH=var/uploads
UPLOAD_CDN_BASE_URL=
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=
UPLOAD_S3_ENDPOINT_URL=
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_AVATAR_BYTES=2097152
UPLOAD_MAX_FILES_PER_POST=8
UPLOAD_TEMPORARY_TTL_HOURS=24

# Backup archives.
# API and worker must share this path/volume.
BACKUP_STORAGE_PATH=var/backups
