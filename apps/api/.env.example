# Local development example. Copy to .env and fill secrets.
# The local private .env is ignored by git.

ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# Canonical public origin and trusted compiled Web shell. Docker Compose sets
# the production values explicitly; direct local API runs may leave them unset.
# PUBLIC_SITE_URL=https://pingxingxian.space
# WEB_APP_SHELL_URL=http://web/index.html

# Docker Compose MySQL service. Keep MYSQL_PASSWORD in sync with DATABASE_URL.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=parallellines
MYSQL_USER=appuser
MYSQL_PASSWORD=change-me-app-password
DATABASE_URL=mysql+asyncmy://appuser:change-me-app-password@db:3306/parallellines?charset=utf8mb4

# For running `uvicorn` directly on the host, use localhost instead:
# DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/parallellines?charset=utf8mb4

# Docker Compose Redis service. Use localhost only when running the API outside Docker.
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
JWT_SECRET_KEY=change-me-in-production-with-at-least-32-bytes
ACCESS_TOKEN_MINUTES=360
REFRESH_TOKEN_DAYS=30

# FableSpace private-space SSO. Use the public FableSpace URL for redirects and
# configure the same service secret in the FableSpace backend.
FABLESPACE_BASE_URL=http://127.0.0.1:3000
FABLESPACE_SSO_SERVICE_SECRET=
FABLESPACE_SSO_TICKET_TTL_SECONDS=60
SLOW_REQUEST_MS=500
BACKGROUND_JOB_POLL_SECONDS=5
BACKGROUND_JOB_BATCH_SIZE=25
BACKGROUND_JOB_RETRY_DELAY_SECONDS=60
BACKGROUND_HOT_RANK_INTERVAL_SECONDS=300
BACKGROUND_UPLOAD_CLEANUP_INTERVAL_SECONDS=3600
BACKGROUND_SESSION_CLEANUP_INTERVAL_SECONDS=3600
BACKGROUND_DIGEST_INTERVAL_SECONDS=3600

# Registration email verification.
# Local/test defaults keep verification emails in memory and expose a dev-only code in API responses.
# Use EMAIL_DELIVERY_MODE=smtp with real SMTP settings in staging/production.
# 163/Netease Mail example:
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_USERNAME=your-name@163.com
#   SMTP_PASSWORD=your-163-smtp-authorization-code
#   SMTP_FROM_EMAIL=your-name@163.com
#   SMTP_USE_TLS=false
#   SMTP_USE_SSL=true
EMAIL_DELIVERY_MODE=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@parallellines.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_CODE_TTL_MINUTES=5
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_TTL_MINUTES=5
PASSWORD_RESET_CODE_MAX_ATTEMPTS=5
EMAIL_CHANGE_TOKEN_TTL_MINUTES=30

# Personal daily-report assistant. The site owns this credential; it is never
# returned to browsers. OPENCODE_API_KEY is shared with the sibling ai- project.
DAILY_REPORT_AI_PROVIDER=opencode
DAILY_REPORT_AI_MODEL=deepseek-v4-flash-free
DAILY_REPORT_AI_BASE_URL=https://opencode.ai/zen
DAILY_REPORT_AI_API_KEY=
OPENCODE_API_KEY=
DAILY_REPORT_AI_TIMEOUT_SECONDS=30
DAILY_REPORT_AI_TEMPERATURE=0.8
DAILY_REPORT_AI_MAX_TOKENS=1600
RATE_LIMIT_DAILY_REPORT_USER=12

# Pure-English PDF translation tool. The dedicated key falls back to
# DAILY_REPORT_AI_API_KEY and then OPENCODE_API_KEY when empty.
PDF_TRANSLATION_AI_MODEL=deepseek-v4-flash-free
PDF_TRANSLATION_AI_BASE_URL=https://opencode.ai/zen
PDF_TRANSLATION_AI_API_KEY=
PDF_TRANSLATION_AI_TIMEOUT_SECONDS=90
PDF_TRANSLATION_AI_TEMPERATURE=0.1
PDF_TRANSLATION_AI_MAX_TOKENS=8000
PDF_TRANSLATION_MAX_BYTES=10485760
PDF_TRANSLATION_MAX_PAGES=30
PDF_TRANSLATION_RENDER_DPI=220
PDF_TRANSLATION_RENDER_TIMEOUT_SECONDS=120
PDF_TRANSLATION_OCR_TIMEOUT_SECONDS=45
PDF_TRANSLATION_BATCH_CHARS=6000
PDF_TRANSLATION_MAX_CONCURRENCY=3
PDF_TRANSLATION_OCR_CONFIDENCE=55
RATE_LIMIT_PDF_TRANSLATION_USER=3
TWO_FACTOR_CHALLENGE_MINUTES=5
TWO_FACTOR_ISSUER=ParallelLines
OAUTH_ENABLED_PROVIDERS=[]
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_IP=5
RATE_LIMIT_REGISTER_EMAIL=3
RATE_LIMIT_LOGIN_IP=10
RATE_LIMIT_LOGIN_ACCOUNT=10
RATE_LIMIT_TOPIC_USER=5
RATE_LIMIT_TOPIC_IP=10
RATE_LIMIT_REPLY_USER=10
RATE_LIMIT_REPLY_IP=20
RATE_LIMIT_UPLOAD_USER=20
RATE_LIMIT_UPLOAD_IP=30
RATE_LIMIT_FLAG_USER=10
RATE_LIMIT_FLAG_IP=20
NEW_USER_LINK_LIMIT=5
NEW_USER_SCREENING_DAYS=7

# Uploads and local attachment storage.
# Local backend stores objects under UPLOAD_STORAGE_PATH; keep it on persistent volume in prod.
# Docker Compose deployment overrides this container path to /var/lib/parallellines/uploads
# and binds host /opt/parallellines/var/uploads there.
UPLOAD_STORAGE_BACKEND=local
UPLOAD_STORAGE_PATH=var/uploads
UPLOAD_CDN_BASE_URL=
UPLOAD_PUBLIC_CDN_URLS=false
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=auto
UPLOAD_S3_ENDPOINT_URL=
UPLOAD_S3_ACCESS_KEY_ID=
UPLOAD_S3_SECRET_ACCESS_KEY=
UPLOAD_S3_REQUEST_TIMEOUT_SECONDS=10
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_AVATAR_BYTES=2097152
UPLOAD_MAX_FILES_PER_POST=8
UPLOAD_TEMPORARY_TTL_HOURS=24

# Backup archives.
# API and worker must share this path/volume.
# Docker Compose deployment overrides this container path to /var/lib/parallellines/backups
# and binds host /opt/parallellines/var/backups there.
BACKUP_STORAGE_PATH=var/backups
