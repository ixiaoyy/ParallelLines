# Local development example. Copy to .env and fill secrets.
# The local private .env is ignored by git.

ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# Docker Compose PostgreSQL default:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parallellines

# MySQL alternative:
# DATABASE_URL=mysql+asyncmy://user:password@host:3306/parallellines

# SQLite for CI/smoke only:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
JWT_SECRET_KEY=change-me-in-production-with-at-least-32-bytes
SLOW_REQUEST_MS=500
HOT_RANK_INTERVAL_SECONDS=300
