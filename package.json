{
  "name": "parallellines",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "typecheck:web": "pnpm --dir apps/web typecheck",
    "lint:web": "pnpm --dir apps/web lint",
    "lint:api": "uv --directory apps/api run ruff check app tests",
    "test:api": "uv --directory apps/api run pytest -q",
    "ci:web": "pnpm --dir apps/web lint && pnpm --dir apps/web typecheck && pnpm --dir apps/web build",
    "test:smoke": "pnpm --dir apps/web test:smoke"
  }
}
